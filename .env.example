# OrcaRouter（可选 AI 网关）
# 申请 Key：https://www.orcarouter.ai/ref/ref_4efd338f7db91cf2aa1d
ORCAROUTER_API_KEY=sk-orca-...

# 可选：默认模型（默认 orcarouter/auto；模型 ID 保留 vendor/model 命名空间）
# ORCAROUTER_MODEL=orcarouter/auto

# 可选：分别覆盖两个 origin（显式值优先，不会由其中一个推导出另一个）
# 推理与模型目录，默认 https://api.orcarouter.ai/v1
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# ORCA_API_BASE_URL=https://api.orcarouter.ai/v1
# 授权，默认 https://www.orcarouter.ai
# ORCA_AUTH_BASE_URL=https://www.orcarouter.ai

# 可选：自建部署的共享 origin，同时承担两种角色，
# 解析为 <shared>（授权）与 <shared>/v1（推理与模型目录）
# ORCA_BASE_URL=https://your-self-hosted-origin
